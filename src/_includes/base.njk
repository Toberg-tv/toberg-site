{% set docTitle = (project.title ~ ' — TOBERG') if (project and project.title) else (pageTitle or site.title) %}
{% set docDescription = project.description if (project and project.description) else (pageDescription or site.description) %}
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ docTitle }}</title>
  <meta name="description" content="{{ docDescription | escape }}">
  <meta property="og:title" content="{{ docTitle | escape }}">
  <meta property="og:description" content="{{ docDescription | escape }}">
  <meta property="og:type" content="website">
  {% if page.url != '/404.html' %}<link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
  <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" href="/assets/img/site/logo-120.png" sizes="120x120">
  <link rel="apple-touch-icon" href="/assets/img/site/logo-240.png">
  <link rel="preload" href="/assets/fonts/montserrat-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/montserrat-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <div class="site-container">
    <div class="site-content">
      <header class="site-header">
        <div class="logo-container">
          <div class="logo-wrap">
            <a href="/" class="logo-link" aria-label="Toberg home">
              {% picture "site/logo", "Toberg", "50px", "logo-img", "eager" %}
            </a>
          </div>
          <button class="hamburger js-hamburger" type="button" aria-label="Open menu" aria-controls="responsive-nav" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
        <div class="nav-container">
          <nav aria-label="Primary">
            <div class="nav-line">
              <a href="/" class="nav-link gallery-title{% if page.url != '/bio-2/' %} active{% endif %}">Projects</a>
            </div>
            <div class="nav-line">
              <a href="/bio-2/" class="nav-link page-title{% if page.url == '/bio-2/' %} active{% endif %}">INFO</a>
              <a href="{{ site.vimeo }}" class="social" target="_blank" rel="noopener" aria-label="Vimeo">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 24" aria-hidden="true" focusable="false"><path d="M23.99 7.7c-0.08 1.8-1.3 4.27-3.67 7.4c-2.45 3.27-4.52 4.9-6.21 4.9c-1.05 0-1.94-0.99-2.66-2.99 c-0.48-1.82-0.97-3.65-1.45-5.48C9.46 9.6 8.9 8.6 8.3 8.55c-0.13 0-0.61 0.29-1.41 0.87L6 8.3C6.89 7.5 7.8 6.7 8.6 5.9 c1.18-1.05 2.07-1.61 2.67-1.66c1.4-0.14 2.3 0.8 2.6 2.95c0.35 2.3 0.6 3.7 0.7 4.24c0.4 1.9 0.8 2.8 1.3 2.8 c0.38 0 0.94-0.61 1.7-1.84c0.75-1.22 1.16-2.16 1.21-2.79c0.11-1.06-0.3-1.59-1.21-1.59c-0.43 0-0.88 0.1-1.33 0.3 c0.88-2.98 2.58-4.43 5.07-4.34C23.23 4.1 24.1 5.3 24 7.7z"/></svg>
              </a>
            </div>
          </nav>
        </div>
      </header>
      <main class="site-main">
        {{ content | safe }}
      </main>
    </div>
  </div>

  <div class="responsive-nav" id="responsive-nav" aria-hidden="true">
    <button class="close-responsive-button js-close-nav" type="button" aria-label="Close menu"></button>
    <nav aria-label="Mobile">
      <a href="/" class="nav-link gallery-title{% if page.url != '/bio-2/' %} active{% endif %}">Projects</a>
      <a href="/bio-2/" class="nav-link page-title{% if page.url == '/bio-2/' %} active{% endif %}">INFO</a>
      <a href="{{ site.vimeo }}" class="social" target="_blank" rel="noopener" aria-label="Vimeo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 24" aria-hidden="true" focusable="false"><path d="M23.99 7.7c-0.08 1.8-1.3 4.27-3.67 7.4c-2.45 3.27-4.52 4.9-6.21 4.9c-1.05 0-1.94-0.99-2.66-2.99 c-0.48-1.82-0.97-3.65-1.45-5.48C9.46 9.6 8.9 8.6 8.3 8.55c-0.13 0-0.61 0.29-1.41 0.87L6 8.3C6.89 7.5 7.8 6.7 8.6 5.9 c1.18-1.05 2.07-1.61 2.67-1.66c1.4-0.14 2.3 0.8 2.6 2.95c0.35 2.3 0.6 3.7 0.7 4.24c0.4 1.9 0.8 2.8 1.3 2.8 c0.38 0 0.94-0.61 1.7-1.84c0.75-1.22 1.16-2.16 1.21-2.79c0.11-1.06-0.3-1.59-1.21-1.59c-0.43 0-0.88 0.1-1.33 0.3 c0.88-2.98 2.58-4.43 5.07-4.34C23.23 4.1 24.1 5.3 24 7.7z"/></svg>
      </a>
    </nav>
  </div>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
